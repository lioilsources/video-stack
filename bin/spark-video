#!/usr/bin/env bash
# spark-video — dlouhý klip z jednoho obrázku, celé z Macu, bez klikání v ComfyUI.
#
#   spark-video new  <jméno> <obrázek> [--scenes N]  # založí manifest, nahraje obrázek
#   spark-video edit <jméno>                         # otevře manifest v $EDITOR
#   spark-video plan <jméno>                         # časová osa a odhad, nic nerenderuje
#   spark-video run  <jméno> [--hd] [--from X] [--until X] [--resume]
#                                                    # render + slepení + RIFE, stáhne výsledek
#   spark-video ls                                   # co už je hotové
#
# --scenes N   kostra N scén × 5 beatů s prázdnými prompty (bez toho 3-beatová ukázka)
# --from X     od beatu / scény X dál (vše za ní se přegeneruje)
# --until X    skonči po beatu / scéně X — náhled první části
# --resume     pokračuj od prvního nehotového beatu (po pádu, nebo po --until)
#
# Manifesty:  <repo>/chains/<jméno>.json      — verzované, čte je i chain.py
# Výsledky:   <repo>/out/<jméno>_{16,32}fps.mp4  — v .gitignore
# Přepíše se: SPARK_VIDEO_DIR, SPARK_HOST
set -euo pipefail

HOST="${SPARK_HOST:-spark}"

# Data patri do repa, ne do home: manifesty jsou zdrojak (chain.py na SPARKu cte
# presne stejne chains/) a vystupy jdou do gitignorovaneho out/. Skript si proto
# najde koren repa sam, at uz se vola odkudkoliv nebo pres symlink.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  SELF="$(cd "$(dirname "$SELF")" && pwd)/$(readlink "$SELF")"
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
DIR="${SPARK_VIDEO_DIR:-$ROOT}"
STACK='Code/video-stack'      # relativně k domovskému adresáři na SPARKu
                             # (scp jede přes SFTP a $HOME v remote cestě neexpanduje)
COMFY='Code/ComfyUI'
CHAINS="$DIR/chains"; OUT="$DIR/out"
mkdir -p "$CHAINS" "$OUT"

die() { echo "spark-video: $*" >&2; exit 1; }
usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
manifest() { echo "$CHAINS/$1.json"; }
need() { [ -f "$(manifest "$1")" ] || die "manifest $1 neexistuje — založ ho: spark-video new $1 <obrázek>"; }
# jméno beatu/scény jde do ssh příkazu, tak ať v něm není nic, co by shell četl
token() { [[ "${1:-}" =~ ^[A-Za-z0-9_-]+$ ]] || die "$2 čeká beat nebo scénu ([A-Za-z0-9_-]), dostal jsem '${1:-}'"; }
# počet beatů z manifestu — scény i plochý seznam
nbeats() { python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); sc=m.get("scenes") or [{"beats": m["beats"]}]; print(sum(len(s["beats"]) for s in sc))' "$1"; }
# součet délek beatů v 81-snímkových jednotkách; délka dědí beat ← scéna ← kořen ← 81 jako v chain.py
beatunits() { python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); sc=m.get("scenes") or [{"beats": m["beats"]}]; print(round(sum(b.get("length", s.get("length", m.get("length", 81)))/81 for s in sc for b in s["beats"]), 2))' "$1"; }
mfps()   { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("fps",16))' "$1"; }

cmd_new() {
  local name="${1:-}" img="${2:-}" scenes=""
  [ -n "$name" ] || usage 1
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "jméno smí být jen [A-Za-z0-9_-]"
  [ -n "$img" ] || die "chybí obrázek: spark-video new $name /cesta/k/fotce.png"
  [ -f "$img" ] || die "obrázek $img neexistuje"
  [ -f "$(manifest "$name")" ] && die "manifest $name už existuje (smaž ho, nebo použij jiné jméno)"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --scenes) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || die "--scenes čeká číslo ≥ 1"; scenes="$2"; shift ;;
      *) die "neznámý přepínač $1 (new umí jen --scenes N)" ;;
    esac; shift
  done

  local ext="${img##*.}"
  local remote="${name}_src.${ext}"
  echo "  nahrávám $img -> $HOST:input/$remote"
  scp -q "$img" "$HOST:$COMFY/input/$remote"

  if [ -n "$scenes" ]; then
    # kostra: N scén × 5 prázdných beatů; id a seed si chain.py dopočítá,
    # prázdný prompt odmítne — takže se nedá omylem renderovat nevyplněná
    python3 - "$(manifest "$name")" "$name" "$remote" "$scenes" <<'PY'
import json, sys
path, name, remote, n = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
m = {
  "name": name, "source": remote, "seed": 42,
  "base": "i2v_final_14b_lightning_portrait",
  "length": 81, "fps": 16, "crf": 18,
  "style_tail": ", static camera, soft natural window light, photorealistic, subtle motion",
  "negative": "blurry, low quality, watermark, text, distorted face, extra fingers",
  "colormatch": {"method": "mkl", "strength": 0.6},
  "_dialy": "motion = síla LoRA na high-noise expertu (níž = víc pohybu, zkus 0.8); boundary = hranice expertů, default 2 (na 3 = víc pohybu); shift = default 5.0 (výš = klidnější)",
  "_delka": "jeden beat = 81 snímků = 5.06 s. Přidej beat = o 5 s delší klip.",
  "_sceny": "id a seed beatů se dopočítají (seed = 42 + pořadí); scéna může přepsat style_tail a negative. Přejmenuj scény, ať jde říct: spark-video run %s --until <scéna>" % name,
  "scenes": [{"name": "scene%d" % (k + 1), "beats": [{"prompt": ""} for _ in range(5)]}
             for k in range(n)],
}
json.dump(m, open(path, "w"), indent=2, ensure_ascii=False)
PY
  else
    cat > "$(manifest "$name")" <<JSON
{
  "name": "$name",
  "source": "$remote",
  "base": "i2v_final_14b_lightning_portrait",
  "length": 81,
  "fps": 16,
  "crf": 18,
  "style_tail": ", static camera, soft natural window light, photorealistic, subtle motion",
  "negative": "blurry, low quality, watermark, text, distorted face, extra fingers",
  "colormatch": { "method": "mkl", "strength": 0.6 },

  "_dialy": "motion = síla LoRA na high-noise expertu (níž = víc pohybu, zkus 0.8); boundary = hranice expertů, default 2 (na 3 = víc pohybu); shift = default 5.0 (výš = klidnější)",
  "_delka": "jeden beat = 81 snímků = 5.06 s. Přidej beat = o 5 s delší klip.",

  "beats": [
    { "id": "01", "seed": 42,
      "prompt": "she breathes gently and blinks slowly, tiny head movement" },
    { "id": "02", "seed": 43,
      "prompt": "a warm smile slowly spreads across her face, slight head tilt" },
    { "id": "03", "seed": 44,
      "prompt": "she raises one hand in a small friendly wave, then lowers it" }
  ]
}
JSON
  fi
  echo "  manifest: $(manifest "$name")"
  echo
  if [ -n "$scenes" ]; then
    echo "  Vyplň prompty ($scenes scén × 5 beatů: spark-video edit $name) a spusť: spark-video run $name"
  else
    echo "  Uprav prompty (spark-video edit $name) a spusť: spark-video run $name"
  fi
}

cmd_edit() { need "$1"; "${EDITOR:-vi}" "$(manifest "$1")"; }

push() { scp -q "$(manifest "$1")" "$HOST:$STACK/chains/$1.json"; }

cmd_plan() {
  need "$1"; push "$1"
  ssh "$HOST" "cd $STACK && ./chain.py chains/$1.json --plan"
}

cmd_run() {
  local name="$1"; shift; need "$name"; push "$name"
  local hd="" extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --hd) hd="--hd" ;;
      --resume) extra+=(--resume) ;;
      --from|--until) token "${2:-}" "$1"; extra+=("$1" "$2"); shift ;;
      *) die "neznámý přepínač $1 (run umí --hd, --from X, --until X, --resume)" ;;
    esac; shift
  done

  ssh "$HOST" "cd $STACK && ./chain.py chains/$name.json --validate" \
    || die "workflow neprošlo validací, nic jsem nespouštěl"

  local n per est fps
  n=$(nbeats "$(manifest "$name")"); fps=$(mfps "$(manifest "$name")")
  per=147; [ -n "$hd" ] && per=331   # s na 81 snímků: 0.44 Mpx vs 1.0 Mpx při 333 s/Mpx
  est=$(python3 -c "print(round($(beatunits "$(manifest "$name")") * $per / 60))")
  local slovo=beatů; [ "$n" = 1 ] && slovo=beat; [ "$n" -ge 2 ] && [ "$n" -le 4 ] && slovo=beaty
  echo "  renderuju na $HOST ($n $slovo${hd:+ v HD}, ~$est min GPU pro celý manifest${extra[0]:+; ${extra[*]} rozsah zúží}, víc když je fronta)…"
  ssh "$HOST" "cd $STACK && ./chain.py chains/$name.json --all $hd ${extra[*]:-}"

  # obě verze dělá chain.py rovnou jako H.264 mp4
  echo "  stahuju…"
  scp -q "$HOST:$COMFY/output/$name/${name}_full.mp4"         "$OUT/${name}_${fps}fps.mp4"
  scp -q "$HOST:$COMFY/output/$name/${name}_$((fps*2))fps.mp4" "$OUT/${name}_$((fps*2))fps.mp4"

  echo
  echo "HOTOVO"
  ls -lh "$OUT/${name}_$((fps*2))fps.mp4" "$OUT/${name}_${fps}fps.mp4" | awk '{print "  "$5"\t"$9}'
  # přehrát jen v interaktivním terminálu, ať to neotevírá okno ve skriptu/CI
  [ -t 1 ] && command -v open >/dev/null && open "$OUT/${name}_$((fps*2))fps.mp4" || true
}

cmd_ls() {
  echo "manifesty  $CHAINS"
  ls -1 "$CHAINS" 2>/dev/null | sed 's/\.json$//' | sed 's/^/  /' || true
  echo "výsledky   $OUT"
  ls -lh "$OUT" 2>/dev/null | awk 'NR>1{print "  "$5"\t"$9}' || true
}

case "${1:-}" in
  new)  shift; cmd_new "$@" ;;
  edit) shift; cmd_edit "${1:?chybí jméno}" ;;
  plan) shift; cmd_plan "${1:?chybí jméno}" ;;
  run)  shift; cmd_run "${1:?chybí jméno}" "${@:2}" ;;
  ls)   cmd_ls ;;
  ""|-h|--help) usage ;;
  *) die "neznámý příkaz ${1} (zkus spark-video --help)" ;;
esac
